# ===== 数据库 =====
# 快速体验可用 SQLite（默认，无需安装数据库）：
DATABASE_URL=sqlite:///./smart_life.db
# 正式部署请改用 MySQL（先导入 database/schema.sql）：
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/smart_life

# ===== 安全 =====
# 生产环境必须替换为长随机字符串，且不得提交到代码仓库
JWT_SECRET=replace-this-with-a-long-random-secret
TOKEN_EXPIRE_DAYS=7
# 刷新令牌有效期（天）：过期前 App 可自动续期，无需重新登录
REFRESH_TOKEN_EXPIRE_DAYS=30
# 跨域来源，多个用英文逗号分隔；生产环境写明前端域名
CORS_ORIGINS=*

# ===== 大模型服务（OpenAI 兼容 chat/completions 接口）=====
# 示例（智谱）：AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  AI_MODEL=glm-4-flash
# 示例（通义）：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 视觉模型（支付截图/小票识别），智谱默认 glm-4v-flash（免费）
AI_VISION_MODEL=glm-4v-flash
AI_TIMEOUT_SECONDS=30
# 每用户每日 AI 调用上限（成本控制）
AI_DAILY_LIMIT=30

# ===== 语音识别（OpenAI 兼容 /audio/transcriptions；P1）=====
# 必须单独填写；不填则语音接口返回 503，前端改用文字。
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_TIMEOUT_SECONDS=60
