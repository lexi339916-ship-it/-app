# ===== 部署环境变量（复制为 deploy/.env 后填写）=====
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*

# 大模型（OpenAI 兼容接口）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=glm-4v-flash
AI_TIMEOUT_SECONDS=30
AI_DAILY_LIMIT=30

# 语音识别（OpenAI 兼容 /audio/transcriptions；不填则语音不可用）
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_TIMEOUT_SECONDS=60
